+// The bound 2D texture shows the depth of a renderbuffer (DF32M), as
+// vglTexImageDepthBuffer does for a framebuffer's.
+void vglTexImageRenderbufferDepth(GLuint rb, GLsizei width, GLsizei height) {
+	THREAD_SAFE()
+
+	renderbuffer *r = (renderbuffer *)rb;
+	texture_unit *tex_unit = &texture_units[server_texture_unit];
+	texture *tex = &texture_slots[tex_unit->tex_id[0]];
+	if (!r || !r->has_surface) {
+		SET_GL_ERROR(GL_INVALID_OPERATION)
+	}
+	sceGxmDepthStencilSurfaceSetForceStoreMode(&r->depthbuffer, SCE_GXM_DEPTH_STENCIL_FORCE_STORE_ENABLED);
+	sceGxmTextureInitLinear(&tex->gxm_tex, r->depthbuffer.depthData, SCE_GXM_TEXTURE_FORMAT_DF32M, width, height, 0);
+	tex->status = TEX_VALID;
+}
+
 GLboolean glIsFramebuffer(GLuint fb) {
 	framebuffer *p = (framebuffer *)fb;
 	return (p && p->active);
