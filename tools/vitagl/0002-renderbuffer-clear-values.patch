diff --git a/source/framebuffers.c b/source/framebuffers.c
index 633b239..099c956 100644
--- a/source/framebuffers.c
+++ b/source/framebuffers.c
@@ -1005,6 +1005,16 @@ void vglRenderbufferForceLoad(GLuint rb, GLboolean load) {
 		sceGxmDepthStencilSurfaceSetForceLoadMode(&r->depthbuffer, load ? SCE_GXM_DEPTH_STENCIL_FORCE_LOAD_ENABLED : SCE_GXM_DEPTH_STENCIL_FORCE_LOAD_DISABLED);
 }
 
+// The depth/stencil a renderbuffer starts a scene with when it is not loaded
+// (its clear values: the GXM's own clear, kept across scene restarts).
+void vglRenderbufferClearValues(GLuint rb, GLfloat depth, GLuint stencil) {
+	renderbuffer *r = (renderbuffer *)rb;
+	if (r && r->has_surface) {
+		sceGxmDepthStencilSurfaceSetBackgroundDepth(&r->depthbuffer, depth);
+		sceGxmDepthStencilSurfaceSetBackgroundStencil(&r->depthbuffer, (uint8_t)stencil);
+	}
+}
+
 // Ends the scene at the next draw and begins another on the same framebuffer
 // (depth/stencil stored, then loaded): its draws can sample them.
 void vglRestartScene(void) {
